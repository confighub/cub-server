{
  "realm": "confighub",
  "enabled": true,
  "displayName": "ConfigHub",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "organizationsEnabled": true,
  "organizations": [
    {
      "name": "default",
      "alias": "default",
      "enabled": true,
      "description": "Every ConfigHub user is a member of this organization.",
      "domains": [
        {
          "name": "confighub.local",
          "verified": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "confighub",
      "name": "ConfigHub server",
      "description": "The server. Authenticates by signing an assertion; holds no secret.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-jwt",
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "use.jwks.string": "true",
        "jwks.string": "",
        "token.endpoint.auth.signing.alg": "EdDSA"
      }
    },
    {
      "clientId": "cub",
      "name": "cub CLI",
      "description": "The CLI. Public: it runs on the user's machine and can hold no credential.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      }
    },
    {
      "clientId": "confighub-ui",
      "name": "ConfigHub UI",
      "description": "The embedded web UI. Public: it runs in the browser, so PKCE and an exact redirect URI stand in for a secret.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "confighub-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-confighub",
      "enabled": true,
      "serviceAccountClientId": "confighub",
      "clientRoles": {
        "realm-management": [
          "realm-admin"
        ]
      }
    }
  ]
}
